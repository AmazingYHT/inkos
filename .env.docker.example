# InkOS Docker 环境配置示本
# 复制到 .env 文件并填入你的值

# LLM 提供商配置
INKOS_LLM_PROVIDER=openai
INKOS_LLM_BASE_URL=https://api.openai.com/v1
INKOS_LLM_API_KEY=sk-your-api-key-here
INKOS_LLM_MODEL=gpt-4o

# 可选配置
INKOS_LLM_SERVICE=openai
INKOS_LLM_TEMPERATURE=0.7
INKOS_DEFAULT_LANGUAGE=zh

# 通知配置（可选）
INKOS_TELEGRAM_BOT_TOKEN=
INKOS_TELEGRAM_CHAT_ID=
INKOS_FEISHU_WEBHOOK_URL=
INKOS_WECOM_WEBHOOK_URL=

# Docker 特定配置
INKOS_DATA_DIR=/data
INKOS_CONFIG_DIR=/data/config

# 端口配置
INKOS_STUDIO_PORT=4567
INKOS_API_PORT=4569

# 守护进程配置
INKOS_DAEMON_LOG_LEVEL=info
INKOS_DAEMON_INTERVAL=3600

# 代理配置（如果需要）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=http://127.0.0.1:7890